# Lora Gateway configuration. Copy to .env and fill in every value marked "change-me":
#   cp .env.example .env && scripts/generate-secrets.sh
# The script replaces each "change-me" below with a freshly generated random value (it never overwrites real values).
# Keep .env private (chmod 600). Never commit it.

# REQUIRED: public DNS name of this server (A/AAAA record must point here; ports 80/443 open).
# Caddy obtains a TLS certificate for it automatically. Example: gateway.example.com
PUBLIC_HOST=gateway.example.com

# Postgres (internal docker network only)
POSTGRES_USER=lora
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# LiteLLM master key: admin credential for the routing engine. Must start with "sk-".
# Used only server-side by the backend; it is never sent to the browser.
# echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=change-me
# Encrypts provider keys inside the LiteLLM DB. NEVER change it after the first start.
# openssl rand -hex 32
LITELLM_SALT_KEY=change-me

# Signs console session tokens (JWT). Changing it logs everybody out.
# openssl rand -hex 32
JWT_SECRET=change-me
# Fernet key that encrypts provider keys and virtual keys in the gateway DB. NEVER change it after the first start.
# python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=change-me

# First admin account, created only when the user table is empty.
ADMIN_USERNAME=admin
# Leave empty to have a random password generated and printed ONCE in the backend log
# (docker compose logs backend | grep -A2 "Generated password"). Min. 10 characters if set.
ADMIN_PASSWORD=

# Optional: Together AI key used only on the very first start to enable the Together provider.
# You can add or change provider keys later in the console (Providers -> Add key).
SEED_TOGETHER_API_KEY=

# Empty = automatic HTTPS (Let's Encrypt / ZeroSSL). "internal" = Caddy's internal CA (testing, LAN, no public DNS).
TLS_MODE=
